# Copy this file to `.env` for local development only.
# Do not commit real secrets. In shared or deployed environments, use CI/CD variables
# or a secret manager instead of a local file.

# Active profile: local | neon | prod
SPRING_PROFILES_ACTIVE=local

# Local PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/summit_project
DB_USERNAME=your_local_db_user
DB_PASSWORD=your_local_db_password

# Neon PostgreSQL
NEON_DB_URL=jdbc:postgresql://your-neon-host:5432/your_database?sslmode=require&channel_binding=require
NEON_DB_USERNAME=your_neon_db_user
NEON_DB_PASSWORD=your_neon_db_password

# Production PostgreSQL
PROD_DB_URL=jdbc:postgresql://your-prod-host:5432/your_database
PROD_DB_USERNAME=your_prod_db_user
PROD_DB_PASSWORD=your_prod_db_password

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION_MINUTES=15
JWT_ISSUER=summit-auth-service

# CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Server
SERVER_PORT=8080
